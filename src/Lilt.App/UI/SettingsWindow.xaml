<Window x:Class="Lilt.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify · Lilt" Width="480" Height="420" MinWidth="420" MinHeight="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#151A20"
        Foreground="#EEF2F6" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20272F" /><Setter Property="Foreground" Value="#EEF2F6" />
            <Setter Property="CaretBrush" Value="#C9F8E4" /><Setter Property="BorderBrush" Value="#39444F" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="10,9" />
            <Setter Property="FontSize" Value="12" /><Setter Property="SelectionBrush" Value="#537C69" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#C9F8E4" /><Setter Property="Foreground" Value="#14231C" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Spotify" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Connect your account to save tracks." Foreground="#9BA8B6" FontSize="12" Margin="0,7,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Client ID" FontSize="12" Foreground="#BCC6D0" Margin="0,0,0,7" />
            <TextBox x:Name="ClientIdBox" MaxLength="128" AutomationProperties.Name="Spotify Client ID" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,17,0,0">
            <TextBlock Text="Redirect URI" FontSize="11" Foreground="#8997A7" Margin="0,0,0,7" />
            <TextBox Text="http://127.0.0.1:43821/callback" IsReadOnly="True" BorderThickness="0" Background="#1A2128" Foreground="#B3C7BD" FontSize="11" AutomationProperties.Name="Spotify redirect URI" />
        </StackPanel>
        <TextBlock Grid.Row="3" Text="Add this URI to your Spotify developer app." Foreground="#778595" FontSize="11" Margin="0,9,0,0" />
        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" Foreground="#A7B7C5" FontSize="12" Margin="0,18,0,0" VerticalAlignment="Top" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="DisconnectButton" Grid.Column="0" Content="Disconnect" Click="OnDisconnect" HorizontalAlignment="Left" Background="#27323B" Foreground="#C4D0DC" />
            <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Click="OnConnect" />
            <Button Grid.Column="2" Content="Done" Click="OnDone" Margin="8,0,0,0" Background="#27323B" Foreground="#C4D0DC" />
        </Grid>
    </Grid>
</Window>
