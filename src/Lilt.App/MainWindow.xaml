<Window x:Class="Lilt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Lilt.Core;assembly=Lilt.Core"
        Title="Lilt" Width="320" Height="96" MinWidth="288" MinHeight="88"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="#FAFCFF"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        MouseLeftButtonDown="OnBodyMouseDown" SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <DropShadowEffect x:Key="ContentShadow" Color="#02060A" Opacity="0.9" BlurRadius="3" ShadowDepth="0.75" Direction="270" />
        <Geometry x:Key="PlayIcon">M8 5 L19 12 L8 19 Z</Geometry>
        <Geometry x:Key="PauseIcon">M7 5 H10 V19 H7 Z M14 5 H17 V19 H14 Z</Geometry>
        <Geometry x:Key="PreviousIcon">M6 5 V19 M19 5 L9 12 L19 19 Z</Geometry>
        <Geometry x:Key="NextIcon">M18 5 V19 M5 5 L15 12 L5 19 Z</Geometry>
        <Geometry x:Key="HeartIcon">M20.84 4.61 C18.89 2.66 15.73 2.66 13.78 4.61 L12 6.39 L10.22 4.61 C8.27 2.66 5.11 2.66 3.16 4.61 C1.21 6.56 1.21 9.72 3.16 11.67 L12 20.51 L20.84 11.67 C22.79 9.72 22.79 6.56 20.84 4.61 Z</Geometry>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CAD1DA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#16FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#28FFFFFF" />
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#15231D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="17" Background="#C9F8E4" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E3FFF1" />
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.12" />
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#A7D6C1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CoverLikeButton" TargetType="Button">
            <Setter Property="Background" Value="#91080D12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Veil" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Heart" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Veil" Property="Background" Value="#B5080D12" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Heart" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=AlbumCover}" Value="False" />
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                    </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    </Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Foreground" Value="#C9F8E4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" CornerRadius="1.5" Background="#C9F8E4" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="8" Height="14">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="7" Height="7" Fill="#E4FFF1" VerticalAlignment="Center" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" CornerRadius="1.5" Background="#24FFFFFF" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent">
        <Border CornerRadius="22" IsHitTestVisible="False">
            <Border.Background>
                <ImageBrush ImageSource="{Binding RefractedBackground}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border.Background>
        </Border>
        <Border CornerRadius="22" Opacity="{Binding GlassOpacity}" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#24343F" Offset="0" />
                    <GradientStop Color="#17232D" Offset="0.42" />
                    <GradientStop Color="#0A121C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border CornerRadius="22" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.18,1">
                    <GradientStop Color="#20FFFFFF" Offset="0" />
                    <GradientStop Color="#06EAF8FF" Offset="0.25" />
                    <GradientStop Color="#00D2EEFF" Offset="0.62" />
                    <GradientStop Color="#0A02070D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border CornerRadius="22" BorderThickness="0.75" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.65,1">
                    <GradientStop Color="#96F3FFFF" Offset="0" />
                    <GradientStop Color="#3AAFC7D6" Offset="0.28" />
                    <GradientStop Color="#14233141" Offset="0.65" />
                    <GradientStop Color="#48B8CFD7" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
        <Border CornerRadius="21" Margin="1" BorderThickness="0,0.75,0,1" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#16FFFFFF" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.12" />
                    <GradientStop Color="#00000000" Offset="0.78" />
                    <GradientStop Color="#4A02070D" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="12,10" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Size}" Value="{x:Static core:WidgetSize.Comfortable}"><Setter Property="Margin" Value="16,12" /></DataTrigger>
                        <DataTrigger Binding="{Binding Size}" Value="{x:Static core:WidgetSize.Expanded}"><Setter Property="Margin" Value="16,12" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="AlbumCover" Grid.Column="0" ToolTip="{Binding ArtworkHint}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Size}" Value="{x:Static core:WidgetSize.Comfortable}"><Setter Property="Width" Value="68" /><Setter Property="Height" Value="68" /></DataTrigger>
                                <DataTrigger Binding="{Binding Size}" Value="{x:Static core:WidgetSize.Expanded}"><Setter Property="Width" Value="80" /><Setter Property="Height" Value="80" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Background="#25322F" CornerRadius="10" BorderThickness="1" BorderBrush="#12FFFFFF">
                        <Grid>
                            <Path Width="23" Height="23" Stretch="Uniform" Data="M9 18 V5 L20 3 V16 M9 8 L20 6 M9 18 C9 21 3 22 3 19 C3 16 9 15 9 18 M20 16 C20 19 14 20 14 17 C14 14 20 13 20 16" Stroke="#93B9A5" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            <Border CornerRadius="9" Visibility="{Binding HasArtwork, Converter={StaticResource VisibleWhenTrue}}">
                                <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" /></Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <Button x:Name="LikeOverlay" Style="{StaticResource CoverLikeButton}" Command="{Binding LikeCommand}" ToolTip="{Binding LikeHint}" AutomationProperties.Name="{Binding SaveLabel}">
                        <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource HeartIcon}" Fill="{Binding HeartFill}" Stroke="{Binding HeartStroke}" StrokeThickness="1.65" StrokeLineJoin="Round" />
                    </Button>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#151D21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" ToolTip="{Binding StatusLabel}">
                        <Ellipse x:Name="StatusMarker" Width="6" Height="6" Fill="{Binding StatusBrush}" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Effect="{StaticResource ContentShadow}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="10,0,6,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Size}" Value="{x:Static core:WidgetSize.Comfortable}"><Setter Property="Margin" Value="12,0,7,0" /></DataTrigger>
                                <DataTrigger Binding="{Binding Size}" Value="{x:Static core:WidgetSize.Expanded}"><Setter Property="Margin" Value="12,0,7,0" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Title}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="FontSize" Value="17" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#DFE7EF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Artist}" />
                    <TextBlock Text="{Binding Album}" FontSize="10.5" Foreground="#B9C8D6" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Visibility="{Binding ShowAlbum, Converter={StaticResource VisibleWhenTrue}}" ToolTip="{Binding Album}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Effect="{StaticResource ContentShadow}">
                    <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" ToolTip="Previous">
                        <Path Width="12" Height="14" Stretch="Uniform" Data="{StaticResource PreviousIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                    </Button>
                    <Button Style="{StaticResource PlayButton}" Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlaybackHint}">
                        <Path Width="15" Height="15" Stretch="Uniform" Fill="#15231D">
                            <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource PlayIcon}" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Data" Value="{StaticResource PauseIcon}" /></DataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" ToolTip="Next">
                        <Path Width="12" Height="14" Stretch="Uniform" Data="{StaticResource NextIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}}" Effect="{StaticResource ContentShadow}">
                <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="22" /></Grid.RowDefinitions>
                <Slider x:Name="SeekControl" Grid.Row="0" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}" IsEnabled="{Binding CanSeek}" SmallChange="5" LargeChange="15" ToolTip="Seek" AutomationProperties.Name="Playback position" PreviewMouseLeftButtonDown="OnSeekStarted" PreviewMouseLeftButtonUp="OnSeekCommitted" LostMouseCapture="OnSeekLostCapture" PreviewKeyUp="OnSeekKeyUp" />
                <Grid Grid.Row="1" Margin="0,1,20,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PositionLabel}" Foreground="#D6E1EB" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding RemainingLabel}" Foreground="#B1C2D1" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding ShowVolume, Converter={StaticResource VisibleWhenTrue}}" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" Data="M11 5 L6 9 H3 V15 H6 L11 19 Z M15 8 C18 10 18 14 15 16 M18 5 C23 9 23 15 18 19" Stroke="#D6E1EB" StrokeThickness="1.6" StrokeLineJoin="Round" />
                        <Slider x:Name="VolumeControl" Width="68" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=TwoWay}" SmallChange="5" LargeChange="10" ToolTip="Spotify volume" AutomationProperties.Name="Spotify volume" PreviewMouseLeftButtonDown="OnVolumeStarted" PreviewMouseLeftButtonUp="OnVolumeCommitted" LostMouseCapture="OnVolumeLostCapture" PreviewKeyUp="OnVolumeKeyUp" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Border x:Name="ResizeGrip" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                CornerRadius="0,0,22,0" Cursor="SizeNWSE" MouseLeftButtonDown="OnResizeMouseDown"
                ToolTip="Resize" AutomationProperties.Name="Resize widget">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Opacity" Value="0.6" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Background" Value="#0DFFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Path Data="M3 15 L15 3 M8 16 L16 8 M13 16 L16 13" Stroke="#D6EBF3" StrokeThickness="1.15" Stretch="Uniform"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"
                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Border>
    </Grid>
</Window>
